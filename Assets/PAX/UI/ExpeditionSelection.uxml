<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(9, 19, 29); align-items: center; justify-content: center;">
        <ui:VisualElement style="width: 1200px; max-width: 96%; max-height: 98%; padding-left: 16px; padding-right: 16px; padding-top: 14px; padding-bottom: 14px;">
            <ui:Label text="PAX / Field expeditions" style="font-size: 29px; -unity-font-style: bold; color: rgb(255, 215, 145);" />
            <ui:Label text="Gather finite materials. Rebuild a route. Discover what remains." style="font-size: 15px; color: rgb(204, 225, 235); margin-top: 4px;" />
            <ui:Label name="selection-status" text="Release held controls to choose." style="font-size: 14px; color: rgb(137, 224, 241); margin-top: 7px; white-space: normal;" />
            <ui:VisualElement style="flex-direction: row; margin-top: 12px;">
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; margin-right: 5px; margin-left: 5px; padding-left: 15px; padding-right: 15px; padding-top: 14px; padding-bottom: 14px; background-color: rgb(20, 35, 48); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                    <ui:Label text="01 / QUIET SHOAL" style="font-size: 13px; -unity-font-style: bold; color: rgb(137, 224, 241);" />
                    <ui:Label text="The survey beacon" style="font-size: 21px; -unity-font-style: bold; color: rgb(239, 246, 241); margin-top: 6px; white-space: normal;" />
                    <ui:Label text="Three shelters survived the storm. Read their marks and restore the island signal." style="font-size: 15px; white-space: normal; color: rgb(216, 233, 231); margin-top: 9px;" />
                    <ui:Label text="Mine 6 Stone near camp, select 3 Stone and rebuild the cyan pad. Survey all three shelters; jump onto the platform and F activates the beacon." style="font-size: 14px; white-space: normal; color: rgb(204, 225, 235); margin-top: 10px;" />
                    <ui:Button name="select-resource" text="1  Start Quiet Shoal fresh" style="height: 35px; font-size: 16px; margin-top: 14px;" />
                    <ui:Button name="continue-resource" text="4  Continue Quiet Shoal" style="height: 35px; font-size: 16px; margin-top: 6px;" />
                    <ui:Label name="saved-resource" text="Checking compatible saved world/resources…" style="font-size: 13px; white-space: normal; color: rgb(255, 222, 167); margin-top: 8px; min-height: 34px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; margin-right: 5px; margin-left: 5px; padding-left: 15px; padding-right: 15px; padding-top: 14px; padding-bottom: 14px; background-color: rgb(20, 35, 48); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                    <ui:Label text="02 / LOWTIDE" style="font-size: 13px; -unity-font-style: bold; color: rgb(137, 224, 241);" />
                    <ui:Label text="The lamplighter's chart" style="font-size: 21px; -unity-font-style: bold; color: rgb(239, 246, 241); margin-top: 6px; white-space: normal;" />
                    <ui:Label text="A broken approach hides the last chart. Cross the channel to find where the inland lamps lead." style="font-size: 15px; white-space: normal; color: rgb(216, 233, 231); margin-top: 9px;" />
                    <ui:Label text="Gather 5 Timber + 3 Stone. Match the crossing and stairs, read three marks and F recovers the chart at the lookout." style="font-size: 14px; white-space: normal; color: rgb(204, 225, 235); margin-top: 10px;" />
                    <ui:Button name="select-chart" text="2  Start Lowtide fresh" style="height: 35px; font-size: 16px; margin-top: 14px;" />
                    <ui:Button name="continue-chart" text="5  Continue Lowtide" style="height: 35px; font-size: 16px; margin-top: 6px;" />
                    <ui:Label name="saved-chart" text="Checking compatible saved world/resources…" style="font-size: 13px; white-space: normal; color: rgb(255, 222, 167); margin-top: 8px; min-height: 34px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; margin-right: 5px; margin-left: 5px; padding-left: 15px; padding-right: 15px; padding-top: 14px; padding-bottom: 14px; background-color: rgb(20, 35, 48); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                    <ui:Label text="03 / EMBER REACH" style="font-size: 13px; -unity-font-style: bold; color: rgb(137, 224, 241);" />
                    <ui:Label text="The ridge of three lamps" style="font-size: 21px; -unity-font-style: bold; color: rgb(239, 246, 241); margin-top: 6px; white-space: normal;" />
                    <ui:Label text="The chart was right. Leave a safe way across the broken ridge for the next walker." style="font-size: 15px; white-space: normal; color: rgb(216, 233, 231); margin-top: 9px;" />
                    <ui:Label text="Gather 5 Timber + 2 Stone. Cross north, turn east at the cairn and climb the steps. Read three notes; F at the bowl rekindles the lamps." style="font-size: 14px; white-space: normal; color: rgb(204, 225, 235); margin-top: 10px;" />
                    <ui:Button name="select-ember" text="3  Start Ember Reach fresh" style="height: 35px; font-size: 16px; margin-top: 14px;" />
                    <ui:Button name="continue-ember" text="6  Continue Ember Reach" style="height: 35px; font-size: 16px; margin-top: 6px;" />
                    <ui:Label name="saved-ember" text="Checking compatible saved world/resources…" style="font-size: 13px; white-space: normal; color: rgb(255, 222, 167); margin-top: 8px; min-height: 34px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="FRESH OR CONTINUE — YOUR CHOICE" style="font-size: 13px; -unity-font-style: bold; color: rgb(137, 224, 241); margin-top: 14px;" />
            <ui:Label text="Fresh starts from the authored world; nothing loads automatically. Continue explicitly restores saved world + resources at camp. Your exact position is not saved; discoveries and activation are session-only and start fresh." style="font-size: 14px; color: rgb(216, 233, 231); white-space: normal; margin-top: 5px;" />
            <ui:Label text="Continue uses a compatible current snapshot, or a compatible previous snapshot if current is unavailable. Spawn clearance is checked on entry. Menu visits, fresh starts and Continue never overwrite saved files. F5 saves; F9 manually loads current; F8 recovers previous; F6 resets only the journal." style="font-size: 14px; color: rgb(216, 233, 231); white-space: normal; margin-top: 5px;" />
            <ui:Label text="1 / 2 / 3 Fresh · 4 / 5 / 6 Continue · Tab / arrows + Enter or buttons. In play: WASD move · Space jump · LMB mine / RMB place · 1–5 materials · Ctrl precise / smart · Q/E orbit · Esc pause / full help." style="font-size: 13px; color: rgb(183, 207, 222); white-space: normal; margin-top: 8px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>